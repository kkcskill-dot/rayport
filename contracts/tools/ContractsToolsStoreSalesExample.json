    "scope_source": "authoritative_store_entitlements",
    "out_of_scope": "reject",
    "apply_to": ["search", "execution", "cache", "mart", "saved_result", "export"]
  },
  "execution": {
    "source_adapter": "apic_approved_tool",
    "source_execution_enabled": false,
    "allow_arbitrary_sql": false,
