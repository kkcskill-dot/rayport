    "@testing-library/user-event": "14.6.8",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "jsdom": "31.0.0",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
